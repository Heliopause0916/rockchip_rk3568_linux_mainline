rockchip: rk3328: Add support for OrangePi R1 Plus LTS
Rewritten for 6.12.103. The base rk3328-orangepi-r1-plus-lts.dts now
exists upstream; keep only the project increment (RTL8153 LED data and
OrangePi R1 Plus LTS LED label overrides).

--- a/arch/arm64/boot/dts/rockchip/rk3328-orangepi-r1-plus-lts.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3328-orangepi-r1-plus-lts.dts
@@ -42,3 +42,23 @@
 		};
 	};
 };
+
+/ {
+	leds {
+		led-0 {
+			label = "orangepi-r1-plus-lts:green:lan";
+		};
+
+		led-1 {
+			label = "orangepi-r1-plus-lts:red:sys";
+		};
+
+		led-2 {
+			label = "orangepi-r1-plus-lts:green:wan";
+		};
+	};
+};
+
+&rtl8153 {
+	realtek,led-data = <0x78>;
+};
